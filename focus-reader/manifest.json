{
  "manifest_version": 3,
  "name": "Focus Reader",
  "version": "4.0",
  "description": "Adjustable reading bracket with readability features for dyslexia & ADHD",
  "action": {
    "default_title": "Toggle Focus Reader"
  },
  "background": {
    "service_worker": "dist/background.js"
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["<all_urls>"],
  "web_accessible_resources": [
    {
      "resources": ["fonts/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "commands": {
    "move-up": {
      "suggested_key": {"default": "Alt+Up"},
      "description": "Move bracket up"
    },
    "move-down": {
      "suggested_key": {"default": "Alt+Down"},
      "description": "Move bracket down"
    },
    "resize-taller": {
      "suggested_key": {"default": "Alt+Shift+Up"},
      "description": "Make bracket taller"
    },
    "resize-shorter": {
      "suggested_key": {"default": "Alt+Shift+Down"},
      "description": "Make bracket shorter"
    }
  }
}
